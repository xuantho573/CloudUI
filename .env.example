# Copy to .env and edit as needed. Everything here is optional: with no .env at
# all, dev servers pick free ports automatically and the host discovers remotes
# through the dev registry.

# --- Dev server ports -------------------------------------------------------
# 0 (the default) means "any free port". Set a fixed number only if you need a
# stable URL, e.g. to point another tool at one of these apps.
HOST_PORT=0
REACT_REMOTE_PORT=0
VUE_REMOTE_PORT=0

# --- Remote entry URLs ------------------------------------------------------
# Set these to point the host at already-deployed remotes. When set, they take
# priority over dev discovery — this is how you run the host against staging or
# production remotes, and how the production build is configured.
# VITE_REACT_REMOTE_URL=https://react-remote.example.com/remoteEntry.js
# VITE_VUE_REMOTE_URL=https://vue-remote.example.com/remoteEntry.js
